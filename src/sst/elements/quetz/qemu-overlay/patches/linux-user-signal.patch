--- a/linux-user/signal.c
+++ b/linux-user/signal.c
@@ -1,6 +1,7 @@
 #include "qemu.h"
 #include "qemu/osdep.h"
 #include "signal.h"
+#include "sst_mmio.h"
 #include "trace.h"
 #include "qemu/error-report.h"
 #include "user-mmap.h"
@@ -800,5 +801,13 @@ void host_signal_handler(int host_signum, siginfo_t *info, void *puc)
     CPUState *cpu = thread_cpu;
     CPUArchState *env = cpu->env_ptr;
+#if defined(TARGET_RISCV64)
+    if (host_signum == SIGSEGV && info) {
+        uintptr_t fa = (uintptr_t)info->si_addr;
+        if (sst_mmio_handle_fault((uint64_t)fa, env, env->pc))
+            return;
+    }
+#endif
+
     trace_user_signal(host_signum, info->si_errno, info->si_code,
                       (target_ulong)info->si_addr);
